Bootstrap: docker
From: vault.habana.ai/gaudi-docker/1.24.1/ubuntu24.04/habanalabs/pytorch-installer-2.11.0:latest

%environment
    export PYTHONUNBUFFERED=1
    export DEBIAN_FRONTEND=noninteractive
    export TZ=UTC
    export PATH="/opt/venv/bin:/usr/local/bin:/usr/bin:/bin"
    export OMPI_MCA_btl_vader_single_copy_mechanism=none

%files
    containers/gaudi/requirements.txt /opt/requirements.txt
    containers/gaudi/requirements-no-deps.txt /opt/requirements-no-deps.txt

%post
    set -eux
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl git python3-venv rsync
    rm -rf /var/lib/apt/lists/*

    # Inherit Intel's HPU torch without modifying the system installation.
    python3 -m venv --system-site-packages /opt/venv
    /opt/venv/bin/python -m pip install --upgrade pip "setuptools<82" wheel
    /opt/venv/bin/python -m pip install \
        --no-cache-dir -r /opt/requirements.txt
    /opt/venv/bin/python -m pip install \
        --no-cache-dir --no-deps -r /opt/requirements-no-deps.txt
    /opt/venv/bin/python -m pip freeze > /opt/pip-freeze.txt

%runscript
    exec /bin/bash "$@"
